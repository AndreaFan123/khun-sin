{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"headers": [
		{
			"source": "/llms.txt",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
				}
			]
		},
		{
			"source": "/og/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800"
				}
			]
		}
	]
}
